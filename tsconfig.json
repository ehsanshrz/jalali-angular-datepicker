{
  "compilerOptions": {
    "target": "ES2022",
    "outDir": "bin",
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "lib": ["ES2022", "dom"]
  },
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}
